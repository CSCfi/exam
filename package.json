{
  "name": "exam",
  "version": "7.1.0",
  "description": "EXAM – electronic exam software for higher education",
  "packageManager": "pnpm@10.32.1",
  "repository": {
    "type": "git",
    "url": " https://github.com/CSCfi/exam.git"
  },
  "license": "EUPL-1.2",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 4200",
    "build": "ng build --output-path ./public",
    "postinstall": "lefthook install",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint --fix",
    "format": "prettier --write \"ui/src/app/**/*.{ts,html}\" --print-width=120 --tab-width=4; exit 0",
    "check-format": "prettier --check \"ui/src/app/**/*.{ts,html}\" --print-width=120 --tab-width=4",
    "check-lint": "ng lint",
    "analyze": "ng build --configuration production && node scripts/internal/analyze-chunks.js"
  },
  "dependencies": {
    "@angular/cdk": "^22.2.0",
    "@angular/common": "^22.1.7",
    "@angular/compiler": "^22.1.7",
    "@angular/core": "^22.1.7",
    "@angular/forms": "^22.1.7",
    "@angular/localize": "^22.1.7",
    "@angular/platform-browser": "^22.1.7",
    "@angular/router": "^22.1.7",
    "@ckeditor/ckeditor5-angular": "^11.2.0",
    "@fullcalendar/angular": "^6.1.21",
    "@fullcalendar/core": "^6.1.21",
    "@fullcalendar/luxon3": "^6.1.21",
    "@fullcalendar/timegrid": "^6.1.21",
    "@ng-bootstrap/ng-bootstrap": "21.0.0",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "chart.js": "^4.5.1",
    "chartjs-plugin-datalabels": "^2.2.0",
    "ckeditor5": "^48.5.2",
    "highlight.js": "^11.12.0",
    "luxon": "^3.7.2",
    "mathlive": "^0.110.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^22.5.0",
    "@angular-eslint/eslint-plugin": "^22.5.0",
    "@angular-eslint/eslint-plugin-template": "^22.5.0",
    "@angular-eslint/schematics": "^22.5.0",
    "@angular-eslint/template-parser": "^22.5.0",
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.7",
    "@eslint/js": "^10.0.1",
    "@types/luxon": "^3.7.5",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "angular-eslint": "^22.5.0",
    "eslint": "^10.11.0",
    "eslint-plugin-no-relative-import-paths": "^1.7.3",
    "jsdom": "^27.4.0",
    "lefthook": "^1.13.6",
    "prettier": "^3.9.9",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.1.11"
  }
}
